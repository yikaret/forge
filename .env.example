# Copy this file to .env and replace the placeholders. The real .env is
# intentionally ignored because it contains developer- and device-specific
# signing values.

# Register this bundle identifier in your Apple Developer account before a
# signed device build. It may be any unique reverse-DNS identifier you own.
APP_ID=com.example.gomage

# Simulator target from: xcrun simctl list devices available
SIM_UDID=00000000-0000-0000-0000-000000000000

# Physical-device target from: xcrun devicectl list devices
IPAD_UDID=00000000-0000-0000-0000-000000000000

# Device builds only. Obtain the identity with:
# security find-identity -v -p codesigning
SIGN_ID='Apple Development: Your Name (TEAMID)'
PROFILE=/absolute/path/to/embedded.mobileprovision
TEAM_ID=YOURTEAMID

# Use an installed JDK 17. Apple-silicon builds are substantially faster with
# a native arm64 JDK.
JAVA_HOME=/absolute/path/to/jdk-17/Contents/Home
